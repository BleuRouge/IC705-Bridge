{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IC705 Bridge",
  "version": "0.1.2",
  "identifier": "com.tao.ic705bridge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IC705 Bridge",
        "width": 980,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "BleuRouge_Fab",
    "category": "Education",
    "shortDescription": "Passerelle CI-V pour l'Icom IC-705 (RS-BA1).",
    "longDescription": "IC705 Bridge connecte un Icom IC-705 en Wi-Fi via le protocole RS-BA1, expose un terminal CI-V intégré et une API HTTP locale pour automatiser les échanges en Python.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/BleuRouge/IC705-Bridge/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMTBERjlFNzcwRkREQkUKUldTKzNROTNudDhRYTA4UUdCMzVVemx5ZzBGT0hhWFlRd21ValJ0MkV0SFl1UjloRnpycVFWckwK"
    }
  }
}
